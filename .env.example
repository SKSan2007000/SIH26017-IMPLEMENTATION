# ==============================================================================
# LANDGUARD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Competition / Prototype Demonstration Mode
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js 14) Configuration
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend API prefix.
# If unset or unreachable, the frontend automatically falls back to offline simulated demo mode.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional MapLibre & Cesium Digital Twin Settings
NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Demonstration Mode Flag
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Backend (FastAPI / SQLAlchemy / ML Engine) Configuration
# ------------------------------------------------------------------------------
# Database Connection URL (SQLite default for prototype, or PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./landguard.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landguard_db

# Security & JWT Token Signing (Use strong random secret in production)
JWT_SECRET_KEY=landguard-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demonstration Mode Safety Flags
DEMO_MODE=true
ALLOW_DEMO_DATA_RESET=true
