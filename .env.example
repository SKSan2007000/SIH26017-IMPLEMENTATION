# ==============================================================================
# LANDGUARD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Land Acquisition & Early Delay Prediction Platform (SIH26017)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js 14) Configuration
# ------------------------------------------------------------------------------
# In Local Development:
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# In Vercel Production Deployment:
#   Leave NEXT_PUBLIC_API_BASE_URL empty or unset.
#   The frontend automatically uses same-origin relative URLs (/api/backend or /api/v1)
#   which are routed by vercel.json rewrites to the FastAPI backend service.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# Optional MapLibre & Cesium 3D Digital Twin Settings
NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ------------------------------------------------------------------------------
# Backend (FastAPI / SQLAlchemy / ML Engine) Configuration
# ------------------------------------------------------------------------------
# Database Connection URL:
#   Local / Demo: sqlite:///./landguard.db (or /tmp/landguard.db on serverless)
#   Production:   postgresql://user:password@host:5432/landguard_db
DATABASE_URL=sqlite:///./landguard.db

# Security & JWT Token Signing (Set a strong 64-char random hex key in production)
SECRET_KEY=landguard-demo-secret-key-change-for-production-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://*.vercel.app"]
