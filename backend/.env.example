# =================================================================
# LandGuard AI — Backend Environment Configuration
# =================================================================

# Server Port (auto-assigned by Railway in production as $PORT)
PORT=8000

# Database URL: SQLite (default fallback) or PostgreSQL with PostGIS
# Railway PostgreSQL: postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
# Local SQLite: sqlite:///./landguard.db
DATABASE_URL=sqlite:///./landguard.db

# JWT Authentication Secret Key & Algorithm
SECRET_KEY=landguard-super-secret-jwt-signing-key-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Static upload storage directory (optional, defaults to backend/data/uploads or /tmp/landguard_uploads)
UPLOAD_DIR=
