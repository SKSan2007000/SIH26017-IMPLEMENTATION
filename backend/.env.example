# LandGuard AI FastAPI Backend Environment Variables
PROJECT_NAME="LandGuard AI API"
API_V1_STR="/api/v1"
SECRET_KEY="landguard-demo-secret-key-change-for-production-environment"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection:
# For Local SQLite (Default / Lightweight out of the box):
DATABASE_URL="sqlite:///./landguard.db"

# For PostgreSQL + PostGIS:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landguard_db"

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
